  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'While I''m stuck here I can''t help but wonder;

    Is a person''s fate
    bound by chance?

    Don''t we have a saying in the grand scheme of life?

    Is
    it destined for me to die alone on this island, or will another soul come to
    my aid?



    Maybe it was my mistake that I let life pass me by,

    but I
    can still send these messages and hope they reach another shore...



    I have
    to try... I have to believe help will come eventually...

    I won''t let go
    of living.

    I simply can''t...

    I put these letters inside this bottle
    and let the waves carry it.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 10e4859bfcf60644096d5eaa839bbefe, type: 2}
  m_sharedMaterial: {fileID: -1259293411052360280, guid: 10e4859bfcf60644096d5eaa839bbefe, type: 2}
